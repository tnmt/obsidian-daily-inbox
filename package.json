{
  "name": "obsidian-daily-inbox",
  "version": "0.2.6",
  "private": true,
  "description": "An ephemeral daily context panel for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "dev:install": "node scripts/install-to-vault.mjs"
  },
  "devDependencies": {
    "@types/node": "latest",
    "builtin-modules": "latest",
    "esbuild": "latest",
    "obsidian": "latest",
    "tslib": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
